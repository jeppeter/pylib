def remove_self_service(args,timeval=2.0):
    retval = remove_update_svc(args)
    if not retval:
        return False
    pid = os.fork()
    if pid == 0:
        # we call this for last time
        cmd = 'import shutil;import time;time.sleep(%s);shutil.rmtree("%s")'%(timeval,args.svcdir)
        logging.info('cmd [%s]'%(cmd))
        os.execlp(sys.executable,sys.executable,'-c',cmd)
    return True


