	return


def update_start_run(ip,username,password,args):
	try:
		uploadfile = os.path.join(args.uploaddir,os.path.basename(os.path.abspath(__file__)))
		run_sshpass_cmds(password,'/usr/bin/ssh',['--','mkdir','-p',args.uploaddir])
		run_sshpass_cmds(password,'/usr/bin/scp',[os.path.abspath(__file__),'%s@%s:%s'%(username,ip,uploadfile)])
		run_sshpass_cmds(password,'/usr/bin/ssh',['%s@%s'%(username,ip),"'%s' '%s' -r startupdate"%(sys.executable,uploadfile)])
	except:
