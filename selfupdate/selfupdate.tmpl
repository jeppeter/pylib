def backup_files_dir():
	global UPDATE_CONFIG
	ns = NameSpaceEx()
	if 'bakfiles' in UPDATE_CONFIG.keys():
		for f in UPDATE_CONFIG['bakfiles']:
			if os.path.exists(f):
				bakf = copy_tempfile(f)
				ns.__setattr__(f,bakf)

	if 'bakdirs' in UPDATE_CONFIG.keys():
		for d in UPDATE_CONFIG['bakdirs']:
			if os.path.exists(d):
				bakd = copy_tempdir(d)
				ns.__setattr__(d,bakd)
	return ns

def restore_files_dir(ns,reserved=False):
	global UPDATE_CONFIG
	allret = True
	if 'bakfiles' in UPDATE_CONFIG.keys():
		for f in UPDATE_CONFIG['bakfiles']:
			bakf = ns.__getattr__(f)
			if bakf is not None:
				retval = back_file_safe(bakf,f,reserved)
				if not retval:
					allret = False

	if 'bakdirs' in UPDATE_CONFIG.keys():
		for d in UPDATE_CONFIG['bakdirs']:
			bakd = ns.__getattr__(d)
			if bakd is not None:
				retval = back_dir_safe(bakd,d,reserved)
				if not retval:
					allret = False
	return


def reserve_or_delete_files_dir(ns,reserved=False):
	global UPDATE_CONFIG
	if ns is None:
		return True
	allret = True
	if 'bakfiles' in UPDATE_CONFIG.keys():
		for f in UPDATE_CONFIG['bakfiles']:
			bakf = ns.__getattr__(f)
			if bakf is not None:
				if reserved:
					logging.info('reserve [%s] for [%s]'%(bakf,f))
				else:
					retval = delete_file_safe(bakf)
					if not retval:
						allret = False

	if 'bakdirs' in UPDATE_CONFIG.keys():
		for d in UPDATE_CONFIG['bakdirs']:
			bakd = ns.__getattr__(d)
			if bakd is not None:
				if reserved:
					logging.info('reserve [%s] for [%s]'%(bakd,d))
				else:
					retval = delete_dir_safe(bakd)
					if not retval:
						allret = False
	return allret




def update_inner(args):
	global UPDATE_DATA
	updatedata = UPDATE_DATA.replace('\n','')
	nullout = open(os.devnull,'w')
	bakns = None
	try:
		# first to move daily
		#retval = move_daily_cron('/home/%s'%(args.username))
		#if not retval:
		#	return False

		bakns = backup_files_dir()
		updatetempd = None


		if len(updatedata) > 0:
			updatetempd = extract_dir(updatedata,args.reserved,args.tempfname)
			if updatetempd is None:
				return False
			logging.debug('updatetempd directory [%s]'%(updatetempd))
			zipdir = os.path.join(updatetempd,args.tempdname)
			logging.debug('zipdir [%s]'%(zipdir))
		if updatetempd is not None:
			updateuninst = os.path.join(updatetempd,args.tempdname,args.uninstname)
			updateinst = os.path.join(updatetempd,args.tempdname,args.instname)



			logging.debug('preuninstall_routine')
			preuninstall_routine(args.instdir,zipdir)
			# to call uninstall
			origuninst = os.path.join(args.instdir,args.uninstname)
			if os.path.exists(origuninst):
				subprocess.check_call(['/bin/bash',origuninst],stderr=nullout)
			logging.debug('postuninstall_routine')
			postuninstall_routine(args.instdir,zipdir)
		logging.debug('preinstall_routine')
		preinstall_routine(args.instdir,zipdir)
		if updatetempd is not None:
			subprocess.check_call(['/bin/bash',updateinst,args.instdir])
		logging.debug('postinstall_routine')
		postinstall_routine(args.instdir,zipdir)

		retval = restore_files_dir(bakns,args.reserved)
		if not retval:
			return False

		if updatetempd is not None:
			if not args.reserved:
				shutil.rmtree(updatetempd,ignore_errors=True)
			updatetempd = None
	except:
		logging.error('%s'%(traceback.format_exc()))
		return False
	finally:
		if updatetempd is not None and not args.reserved:
			shutil.rmtree(updatetempd,ignore_errors=True)
		updatetempd = None
		if nullout is not None:
			nullout.close()
		nullout = None
		reserve_or_delete_files_dir(bakns,args.reserve)
	return True

