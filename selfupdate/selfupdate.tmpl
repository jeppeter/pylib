def new_args_parser():
	parser = argparse.ArgumentParser(prog=os.path.basename(os.path.abspath(__file__)).replace('.py',''))
	parser.add_argument('-v', '--verbose', action='count', default=0)
	parser.add_argument('-R','--reserved',action='store_true',default=False)
	parser.add_argument('-r','--reboot',action='store_true',default=False)
	parser.add_argument('--username',action='store',default='pyuser')
	parser.add_argument('--password',action='store',default='pyuser')
	parser.add_argument('--svcdir',action='store',default='/usr/bin/updatesvc')
	parser.add_argument('--instdir',action='store',default='/usr/bin/selfsvc')
	parser.add_argument('--tempfname',action='store',default='selfupdate')
	parser.add_argument('--tempdname',action='store',default='/tmp')
	parser.add_argument('--uploaddir',action='store',default='/usr/bin/uploadsvc')
	parser.add_argument('--uninstname',action='store',default='uninst.sh')
	parser.add_argument('--instname',action='store',default='inst.sh')
	return parser

%COMMAND_PARSER_CODE%

def add_parser_handlers(parser):
	subparsers = parser.add_subparsers()
	update_group = subparsers.add_parser('update')
	upload_group = subparsers.add_parser('upload')
	version_group = subparsers.add_parser('version')
	extract_group = subparsers.add_parser('extract')
	stopservice_group = subparsers.add_parser('stopservice')
	startupdate_group = subparsers.add_parser('startupdate')
	updatesvc_group = subparsers.add_parser('updatesvc')
	uploadstart_group = subparsers.add_parser('uploadstart')
	update_group.add_argument('subnargs',type=str,nargs="*")
	update_group.set_defaults(func=update_handler)
	upload_group.add_argument('subnargs',type=str,nargs="*")
	upload_group.set_defaults(func=upload_handler)
	version_group.add_argument('subnargs',type=str,nargs="*")
	version_group.set_defaults(func=version_handler)
	extract_group.add_argument('subnargs',type=str,nargs="*")
	extract_group.set_defaults(func=extract_handler)
	stopservice_group.add_argument('subnargs',type=str,nargs="*")
	stopservice_group.set_defaults(func=stopservice_handler)
	startupdate_group.add_argument('subnargs',type=str,nargs="*")
	startupdate_group.set_defaults(func=startupdate_handler)
	updatesvc_group.add_argument('subnargs',type=str,nargs="*")
	updatesvc_group.set_defaults(func=updatesvc_handler)
	uploadstart_group.add_argument('subnargs',type=str,nargs="*")
	uploadstart_group.set_defaults(func=uploadstart_handler)
	return parser

def main():
	if len(sys.argv) == 1:
		args = make_default_args()
		retval = update_handler(args)
		if retval:
			sys.exit(0)
		sys.exit(4)
	parser = new_args_parser()
	parser = add_parser_handlers(parser)
	args = parser.parse_args()
	retval = args.func(args)
	if not retval :
		sys.exit(4)
	sys.exit(0)

if __name__ == '__main__':
	main()



