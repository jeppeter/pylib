def set_logging(args):
    loglvl= logging.ERROR
    if args.verbose >= 3:
        loglvl = logging.DEBUG
    elif args.verbose >= 2:
        loglvl = logging.INFO
    if logging.root is not None and len(logging.root.handlers) > 0:
        logging.root.handlers = []

    cformat = '%(asctime)s:%(filename)s:%(funcName)s:%(lineno)d\t%(message)s'
    basicfmt = logging.Formatter(cformat)

    logging.basicConfig(level=loglvl,format=cformat)
    if not args.logstderr:
        logging.root.handlers = []

    for f in args.logapps:
        if args.logmaxsize > 0:
            apphdl = RotatingFileHandler(f,mode='a',backupCount=1,maxBytes=args.logmaxsize)
        else:
            apphdl = RotatingFileHandler(f,mode='a')
        apphdl.setFormatter(basicfmt)
        apphdl.setLevel(loglvl)
        logging.root.addHandler(apphdl)
    for f in args.logfiles:
        if args.logmaxsize > 0:
            loghdl = RotatingFileHandler(f,mode='w',backupCount=1,maxBytes=args.logmaxsize)
        else:
            loghdl = RotatingFileHandler(f,mode='w')
        loghdl.setFormatter(basicfmt)
        loghdl.setLevel(loglvl)
        logging.root.addHandler(loghdl)

    for f in args.logfatals:
        try:
            fsize = os.path.getsize(f)
            if fsize > 0x100000:
                os.remove(f)
        except:
            pass
        loghdl = logging.FileHandler(f,mode='a')
        loghdl.setFormatter(basicfmt)
        loghdl.setLevel(logging.FATAL)
        logging.root.addHandler(loghdl)

    return

def read_file(infile=None):
    fin = sys.stdin
    if infile is not None:
        fin = open(infile,'r+b')
    rets = ''
    for l in fin:
        s = l
        if 'b' in fin.mode:
            if sys.version[0] == '3':
                s = l.decode('utf-8')
        rets += s

    if fin != sys.stdin:
        fin.close()
    fin = None
    return rets

def write_file(s,outfile=None):
    fout = sys.stdout
    if outfile is not None:
        fout = open(outfile, 'w+b')
    outs = s
    if 'b' in fout.mode:
        outs = s.encode('utf-8')
    fout.write(outs)
    if fout != sys.stdout:
        fout.close()
    fout = None
    return 

def zip_dir(d):
    tempout = None
    curdir = None
    partname = None
    try:
        curdir = os.getcwd()
        partd = os.path.basename(os.path.abspath(d))
        os.chdir(os.path.dirname(os.path.abspath(d)))
        tempout = tempfile.NamedTemporaryFile(delete=False,suffix='.zip')
        tempout.close()
        with zipfile.ZipFile(tempout.name,'w') as zobj:
            for dname,sdirs,fnames in os.walk(partd):
                for f in fnames:
                    logging.debug('dname [%s] f[%s]'%(dname,f))
                    curf = os.path.join(dname,f)
                    zobj.write(curf)
        os.chdir(curdir)
        curdir = None
        return tempout.name
    except:
        logging.error('%s'%(traceback.format_exc()))
        if curdir is not None:
            os.chdir(curdir)
            curdir = None
        return None

