def zip64_handler(args,parser):
    set_logging(args)
    keyword = args.subnargs[0]
    if len(args.subnargs) > 1:
        zipdir = args.subnargs[1]
    else:
        zipdir = None
    logging.info('keyword [%s] zipdir [%s]'%(keyword,zipdir))
    fin = sys.stdin
    fout = sys.stdout
    if args.input is not None:
        fin = open(args.input,'r')
    if args.output is not None:
        fout = open(args.output,'w')
    retval = zip_replace_keyword(zipdir,fin,keyword,fout,args.reserved)
    if fin != sys.stdin:
        fin.close()
    fin = None
    if fout != sys.stdout:
        fout.close()
    fout = None
    if not retval :
        sys.exit(4)
    sys.exit(0)
    return

def replcode_handler(args,parser):
    set_logging(args)
    keyword = args.subnargs[0]
    repls = ''
    if len(args.subnargs) > 1:
        infile = args.subnargs[1]
        repls = read_file(infile)
    ins = read_file(args.input)
    outs = ''
    sarr = re.split('\n',ins)
    for l in sarr:
        l = l.rstrip('\r')
        l = l.replace('%%%s%%'%(keyword),repls,-1)
        outs += '%s\n'%(l)
    write_file(outs,args.output)
    sys.exit(0)
    return


